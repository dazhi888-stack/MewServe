# 复制本文件为 .env 后填写。三项模型配置留空时 /health 可启动，模型接口返回未配置错误。

# ---- DeepSeek 模型（必填才能真正回答）----
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 输出上限的线协议字段：兼容端点用 max_tokens（默认）。
DEEPSEEK_TOKEN_LIMIT_FIELD=max_tokens

# ---- RAG / Chroma 知识库（新增）----
# 设为 false 可整体关闭意图识别 + RAG（回到纯对话基线行为）。
RAG_ENABLED=true
# Chroma 持久化目录与 FAQ 源文件；服务启动时集合为空会自动导入。
CHROMA_DIR=./chroma_db
FAQ_FILE=./knowledge/faqs.md
RAG_TOP_K=4
# 混合检索：向量与 BM25 各自召回的候选数（RRF 融合前每路 top-k）。
RAG_CANDIDATE_K=12
# 重排：融合候选送 bge-reranker 精排（复用 EMBEDDING_* 配置）。
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 多轮对话时先用模型把追问改写成独立检索问题。
QUERY_REWRITE_ENABLED=true
# Embedding 走 OpenAI 兼容接口（推荐硅基流动 BAAI/bge-m3，中文效果好）；
# 不填 EMBEDDING_API_KEY 时回退到 Chroma 自带的本地默认 embedding。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# ---- 意图识别（新增）----
# 设为 false 关闭意图分支，所有消息直接走 RAG 问答。
INTENT_ENABLED=true
# 兜底式两档路由：>=0.85 正常回答；(0.60, 0.85) 回答但话术带对冲；<=0.60 拒绝。
INTENT_HIGH_THRESHOLD=0.85
INTENT_LOW_THRESHOLD=0.60

# ---- 结构化输出（意图识别 / 售后提取共用）----
# 显式选择 json_mode 或 json_schema；不自动回退到工具调用。
STRUCTURED_OUTPUT_METHOD=json_mode

# ---- 上下文预算 ----
# 回复预留 + 安全余量必须严格小于上下文窗口。
CONTEXT_WINDOW_TOKENS=8192
MAX_OUTPUT_TOKENS=512
TOKEN_SAFETY_MARGIN=512
# 设为 0 禁用历史消息；服务端不存储会话。
HISTORY_MAX_MESSAGES=20
REQUEST_TIMEOUT_SECONDS=60
SHOP_NAME=MewServe
